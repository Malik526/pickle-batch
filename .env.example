# Content Automation environment template.
# Copy this file to `.env` for local use and keep real credential values out of Git.

# Shared Google service account key used by growth agency tools.
# Do not duplicate this JSON file into the tool directory.
# Only used for the --calendar advanced/debug override on generate_calendar.py
# / clear_calendar.py — normal operation uses OAuth instead, see below.
GOOGLE_SERVICE_ACCOUNT_FILE=/path/to/service-account.json

# Legacy/advanced-override calendar ID — no longer an implicit default
# anywhere. Only relevant if you pass --calendar with no explicit value in
# your own scripting; normal operation always targets the dedicated
# app-owned "Content Automation" calendar instead. See
# docs/decisions/0004-dedicated-google-calendar-ownership.md.
GOOGLE_CALENDAR_ID=

# Calendar event timezone.
CONTENT_CALENDAR_TIMEZONE=America/New_York

# --- Dedicated app-owned Google Calendar (OAuth) ---
# One-time setup: create an OAuth 2.0 Client ID (Desktop app) in Google Cloud
# Console on a project with the Calendar API enabled, save its JSON at the
# path below. See README.md "Calendar Ownership" / ADR-0004.
CONTENT_CALENDAR_OAUTH_CLIENT_SECRETS=~/.config/content-calendar/calendar_oauth_client_secrets.json
CONTENT_CALENDAR_OAUTH_TOKEN_PATH=~/.config/content-calendar/calendar_oauth_token.json
CONTENT_CALENDAR_APP_CALENDAR_SUMMARY=Content Automation
CONTENT_CALENDAR_APP_CALENDAR_STATE_PATH=

# Default generation window used when no CLI month/year is provided.
CONTENT_CALENDAR_DEFAULT_MONTH=6
CONTENT_CALENDAR_DEFAULT_YEAR=2026

# --- Routing & caption strategy (Milestone 1.3) ---

# "fifo" (default): schedule videos deterministically in ingestion order
# into untyped slots, no classifier involved. "pillar": the original
# classify-then-match strategy. See docs/decisions/0005-....
CONTENT_CALENDAR_ROUTING_MODE=fifo

# "transcript_auto" (default): derive a caption candidate from the
# transcript, no truncation. "manual": never write caption_text here
# (reserved for a future editing UI). "none": no caption.
CONTENT_CALENDAR_CAPTION_MODE=transcript_auto

# --- process_content.py: video ingestion pipeline ---

# Which ContentClassifier to use: "embeddings" (default, fully local, no API
# key) or "claude". Only relevant when CONTENT_CALENDAR_ROUTING_MODE=pillar
# — "fifo" mode never constructs a classifier. See classification.py /
# docs/decisions/0003-....
CONTENT_CALENDAR_CLASSIFIER=embeddings

# Claude API key — only needed if CONTENT_CALENDAR_CLASSIFIER=claude, or for
# `python3 evaluate_classifier.py --classifier claude`.
# Same key/pattern as internal-tools/content-analytics.
ANTHROPIC_API_KEY=

# Claude-classifier-specific confidence threshold for automatic slot
# assignment. Below this, ClaudeClassifier abstains (NEEDS_REVIEW).
CONTENT_CALENDAR_AUTO_ASSIGN_THRESHOLD=0.80

# faster-whisper local transcription settings.
CONTENT_CALENDAR_WHISPER_MODEL=base
CONTENT_CALENDAR_WHISPER_DEVICE=cpu
CONTENT_CALENDAR_WHISPER_COMPUTE_TYPE=int8

# EmbeddingClassifier settings (local, no API key). See
# docs/decisions/0003-local-embedding-classification.md — the thresholds
# below are UNCALIBRATED placeholders; use
# `evaluate_classifier.py --classifier embeddings --sweep` to pick real ones.
CONTENT_CALENDAR_EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
CONTENT_CALENDAR_EMBEDDING_CACHE_DIR=
CONTENT_CALENDAR_EMBEDDING_MIN_SIMILARITY=0.50
CONTENT_CALENDAR_EMBEDDING_MIN_MARGIN=0.03

# SQLite database path for videos/content_slots/platform_posts. Defaults to
# data/content.db inside this tool directory if unset. Still the default
# dev/test backend after Milestone 3.3 (see DATABASE_URL below).
CONTENT_CALENDAR_DB_PATH=

# --- Postgres (Milestone 3.3, hosted persistence) ---
# Real libpq connection string (postgresql://user:password@host:port/dbname).
# Empty means "use SQLite" — see persistence/store_factory.py. If your
# provider's direct-connection host is IPv6-only (Supabase's is), use its
# IPv4-compatible connection pooler string instead. Never commit a real value.
DATABASE_URL=
# Postgres schema PostgresContentStore operates against. Defaults to "public".
POSTGRES_SCHEMA=
# Dedicated schema the Postgres integration test suite uses instead of
# POSTGRES_SCHEMA, so tests never touch real business rows. Defaults to
# "pickle_batch_test".
POSTGRES_TEST_SCHEMA=

# --- Object storage (Milestone 3.4, media lifecycle) ---
# "local" (default) keeps every existing local-filesystem ingestion/
# publishing behavior unchanged — nothing requires this to be configured.
# "supabase" enables the real hosted backend for the new, additive
# upload/materialize capability (media/media_storage.py). See
# storage/factory.py.
STORAGE_BACKEND=
# Base directory for the local storage backend. Defaults to
# data/media_storage inside this tool directory if unset.
LOCAL_STORAGE_ROOT=
# Reuses the same Supabase project as DATABASE_URL above — but object
# storage is a separate decision from Postgres; see
# docs/decisions/0009-object-storage-media-lifecycle.md.
SUPABASE_URL=
# Server-side only, full storage access, never exposed client-side. Note:
# this variable is literally named SERVICE_ROLE_KEY, not
# SUPABASE_SERVICE_ROLE_KEY — config.py reads it under that name.
SERVICE_ROLE_KEY=
# Private bucket holding real canonical media. Defaults to
# "pickle-batch-media".
SUPABASE_STORAGE_BUCKET=
# Separate, disposable bucket the storage integration test suite uses
# instead of SUPABASE_STORAGE_BUCKET — never the real media bucket.
# Defaults to "pickle-batch-test".
SUPABASE_STORAGE_TEST_BUCKET=

# --- TikTok publishing (Milestone 2.0) ---
# One-time setup: create an app in the TikTok Developer Portal
# (https://developers.tiktok.com/) with Login Kit + Content Posting API
# enabled, set the two credential values below, then run:
#   python3 tiktok_auth.py --authorize
# This starts a temporary local callback server (PKCE + state, per TikTok's
# current Desktop Login Kit requirements) and opens/prints the
# authorization URL — approve as the dedicated test account. Never commit
# real values for these. See README.md "TikTok Publishing Setup" /
# docs/decisions/0006-....
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=

# Optional. Only needed if your app registration requires an exact fixed
# redirect URI/port rather than relying on TikTok's wildcard-port support
# for desktop apps, or to use the manual --print-auth-url/--exchange-code
# fallback instead of --authorize. This is the LOCAL DESKTOP/CLI flow's
# variable only (tiktok_auth.py) — deploying the hosted web app (Railway)
# needs TIKTOK_WEB_REDIRECT_URI instead (see the API section below). Do
# not set this to a Railway/production URL; the hosted flow never reads it.
TIKTOK_REDIRECT_URI=

# Comma-separated OAuth scopes.
CONTENT_CALENDAR_TIKTOK_SCOPES=user.info.basic,video.publish

# Cached access/refresh token pair (written by tiktok_auth.py), outside the
# repo like the Calendar OAuth token.
CONTENT_CALENDAR_TIKTOK_TOKEN_PATH=~/.config/content-calendar/tiktok_token.json

# Privacy level for every publish_tiktok.py post in this milestone.
# SELF_ONLY (private) is required — this app is an unaudited TikTok client
# and TikTok restricts unaudited Direct Post to SELF_ONLY. See ADR-0006.
CONTENT_CALENDAR_TIKTOK_DEFAULT_PRIVACY_LEVEL=SELF_ONLY

# TikTok's Direct Post caption limit, in UTF-16 code units (not Python
# characters). publish_tiktok.py fails clearly rather than truncating a
# caption over this limit.
CONTENT_CALENDAR_TIKTOK_MAX_CAPTION_UTF16_UNITS=2200

# --- Real authentication (Milestone 3.6, Supabase Auth) ---
# The backend verifies a Supabase Auth JWT the frontend already obtained —
# it never authenticates a user directly. See
# docs/decisions/0011-real-authentication-and-tiktok-connection.md.

# "jwks" (default, preferred) — Supabase's asymmetric signing keys; no
# shared secret needed server-side. "hs256" — Supabase's legacy shared
# JWT secret (requires SUPABASE_JWT_SECRET below).
SUPABASE_AUTH_JWT_MODE=jwks
# Only needed to override the default derivation from SUPABASE_URL
# (<SUPABASE_URL>/auth/v1/.well-known/jwks.json).
SUPABASE_AUTH_JWKS_URL=
# Only needed if SUPABASE_AUTH_JWT_MODE=hs256. Server-side only — never
# expose client-side, never log, never commit a real value. Find it in
# the Supabase dashboard under Settings > API > JWT Settings.
SUPABASE_JWT_SECRET=
# Supabase's default JWT "aud" claim for a signed-in user.
SUPABASE_AUTH_AUDIENCE=authenticated

# --- Hosted TikTok credential encryption (Milestone 3.6) ---
# Symmetric key encrypting a hosted TikTok connection's access/refresh
# token pair at rest (platform_credentials.encrypted_payload) — server-side
# only, never a default. Generate one with:
#   python3 -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# Never commit a real value; rotating it invalidates every stored hosted
# TikTok credential (users would need to reconnect).
CREDENTIAL_ENCRYPTION_KEY=

# --- API (Milestone 3.6, src/content_automation/api/) ---
# The four vars below (API_CORS_ALLOWED_ORIGINS, FRONTEND_BASE_URL,
# TIKTOK_WEB_REDIRECT_URI, and NEXT_PUBLIC_API_BASE_URL in web/.env.local)
# are the ones that differ between local dev and the real Railway/Netlify
# deployment (Milestone 3.6.1, see railway.json at the repo root for the
# Railway build/start config) — every other var in this file is the same
# in both places. In Railway's dashboard (Variables tab), set these to the
# real Netlify site origin and the real Railway-assigned domain; locally,
# the defaults below (or an unset TIKTOK_WEB_REDIRECT_URI, which fails
# closed rather than silently using a wrong value) are correct.
#
# Comma-separated allowlist of frontend origin(s) permitted to call the
# authenticated API — never "*". Where the TikTok OAuth callback redirects
# the browser back to once finished (defaults to the first CORS origin).
# Instagram's default return target is FRONTEND_BASE_URL + /app/settings
# (Milestone 4.1): it must resolve to https:// (or http://localhost), or
# Settings won't offer Instagram Connect. Leave it empty to use the first
# CORS origin.
API_CORS_ALLOWED_ORIGINS=http://localhost:3000
FRONTEND_BASE_URL=
# How long a pending OAuth connect attempt's server-side state is valid
# before it's treated as expired, in seconds.
OAUTH_STATE_TTL_SECONDS=600
# Optional (Milestone 4.1). Extra exact URLs an OAuth attempt may return
# the browser to after its callback, comma-separated, besides the web
# Settings page. Leave empty for the web app; reserved for a future native
# app's universal link. Exact match only; https:// entries only.
OAUTH_EXTRA_RETURN_TARGETS=
# The exact redirect_uri the hosted TikTok OAuth flow sends to TikTok and
# must be registered verbatim in TikTok Developer Portal > Login Kit >
# Web > Redirect URI. Must be an absolute https:// URL — no default, and
# connect requests fail clearly (500) until this is set. Distinct from
# TIKTOK_REDIRECT_URI above, which is only for the local desktop/CLI flow.
# Example (Railway): https://<your-app>.up.railway.app/api/platforms/tiktok/callback
TIKTOK_WEB_REDIRECT_URI=

# --- Instagram (Milestone 4.0 config contract; 4.1 OAuth; Reels publishing 4.2) ---
# Instagram API with Instagram Login (Business Login for Instagram):
# Instagram professional (Business/Creator) accounts, no Facebook Page.
# API service only (Railway "api"); the worker never needs these — token
# refresh and publishing use only the user's stored access token. Never
# expose any of these to Netlify/the browser (no NEXT_PUBLIC_ prefix).
# See docs/decisions/0018-instagram-integration-architecture.md.
#
# Instagram app ID and secret from Meta App Dashboard > Instagram >
# "API setup with Instagram login" (not the Meta/Facebook app ID).
INSTAGRAM_APP_ID=
INSTAGRAM_APP_SECRET=
# Backend callback, registered verbatim under Business login settings >
# OAuth redirect URIs. Absolute https:// URL (route added in Milestone 4.1).
# Example (Railway): https://<your-app>.up.railway.app/api/platforms/instagram/callback
INSTAGRAM_REDIRECT_URI=
# Optional. Graph API version for Content Publishing calls (default v25.0).
INSTAGRAM_GRAPH_API_VERSION=
# Optional, worker service. Lifetime in seconds (300–86400, default 3600) of
# the signed storage URL Instagram fetches a Reel from (Milestone 4.2). The
# worker needs STORAGE_BACKEND=supabase and no Instagram secret.
INSTAGRAM_MEDIA_URL_TTL_SECONDS=
# Optional, worker service (Milestones 4.2.1/4.2.3). Max seconds for one
# Instagram media normalization (default 3600), and ffmpeg decoder/encoder
# threads (default 2; use 1 if the worker has ≤512 MB of memory).
INSTAGRAM_NORMALIZATION_TIMEOUT_SECONDS=
INSTAGRAM_NORMALIZATION_THREADS=
# Optional (Milestone 4.1). A stored 60-day Instagram token is refreshed on
# first use once at least 24 h old and with fewer than this many seconds
# left (86400–5097600, default 2592000 = 30 days).
INSTAGRAM_TOKEN_REFRESH_WINDOW_SECONDS=
